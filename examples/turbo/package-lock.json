{
  "name": "don-turbo-example",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "don-turbo-example",
      "workspaces": [
        "apps/*",
        "packages/*"
      ]
    },
    "apps/web": {
      "name": "@example/web",
      "version": "0.0.1",
      "dependencies": {
        "@example/utils": "*"
      }
    },
    "node_modules/@example/utils": {
      "resolved": "packages/utils",
      "link": true
    },
    "node_modules/@example/web": {
      "resolved": "apps/web",
      "link": true
    },
    "packages/utils": {
      "name": "@example/utils",
      "version": "0.0.1"
    }
  }
}
